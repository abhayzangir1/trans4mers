datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

enum AgentStatus {
  IDLE
  RUNNING
  HALTED
  FIRED
  ERROR
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
  TOOL
}

enum ArtifactStatus {
  PENDING
  GENERATING
  COMPLETED
  ERROR
}

model Project {
  id                 String         @id @default(uuid())
  sessionId          String?
  name               String
  directoryPath      String
  globalInstructions String?
  description        String?
  conversations      Conversation[]
  teams              ProjectTeam[]
  uploads            Upload[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([sessionId])
  @@index([createdAt])
}

model Conversation {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String?
  status            ConversationStatus @default(ACTIVE)
  channels          Channel[]
  agentInstances    AgentInstance[]
  blackboard        SharedBlackboard[]
  memories          MemoryBank[]
  artifacts         Artifacts[]
  uploads           Upload[]
  commandExecutions CommandExecution[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([projectId])
  @@index([createdAt])
}

model AgentTemplate {
  id           String          @id @default(uuid())
  sessionId    String?
  name         String
  role         String
  systemPrompt String
  allowedTools Json?
  projectTeams ProjectTeam[]
  instances    AgentInstance[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([sessionId])
  @@index([createdAt])
}

model ProjectTeam {
  projectId       String
  agentTemplateId String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentTemplate   AgentTemplate @relation(fields: [agentTemplateId], references: [id], onDelete: Cascade)

  @@id([projectId, agentTemplateId])
}

model AgentLog {
  id              String        @id @default(uuid())
  agentInstanceId String
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  content         String
  createdAt       DateTime      @default(now())

  @@index([agentInstanceId])
  @@index([createdAt])
}

model Channel {
  id             String       @id @default(uuid())
  conversationId String
  name           String
  isDM           Boolean      @default(false)
  isReadOnly     Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, name])
  @@index([conversationId])
  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  sessionId String?  @unique
  name      String   @default("Human")
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id               String   @id @default(uuid())
  channelId        String
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId         String 
  agentId          String?
  userId           String?
  agent            AgentInstance? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  role             MessageRole 
  content          String
  requiresApproval Boolean  @default(false)
  approvalState    ApprovalState? 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([channelId])
  @@index([channelId, role])
  @@index([createdAt])
}

model MemoryBank {
  id             String                      @id @default(uuid())
  conversationId String?
  conversation   Conversation?               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                    @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model FileLocks {
  id            String        @id @default(uuid())
  filePath      String
  agentId       String
  agentInstance AgentInstance @relation(fields: [agentId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime      @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@index([expiresAt])
  @@unique([agentId, filePath])
}

model Artifacts {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  filePath       String
  status         ArtifactStatus
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([createdAt])
}

model Upload {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String
  filePath       String
  fileSize       Int
  mimeType       String
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([projectId])
  @@index([createdAt])
}

model SystemLock {
  id        String   @id
  ownerId   String?
  lockedAt  DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

model CommandExecution {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  command        String
  output         String
  exitCode       Int?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model AgentInstance {
  id               String  @id @default(uuid())
  conversationId   String
  templateId       String
  parentInstanceId String?
  status           AgentStatus @default(IDLE)
  haltRequested    Boolean @default(false)
  currentTaskId    String?
  contextState     Json?

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  template       AgentTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentInstance AgentInstance?  @relation("ParentChild", fields: [parentInstanceId], references: [id], onDelete: Cascade)
  childInstances AgentInstance[] @relation("ParentChild")
  logs           AgentLog[]
  fileLocks      FileLocks[]
  messages       Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([templateId])
  @@index([parentInstanceId])
  @@index([createdAt])
}

model SharedBlackboard {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, key])
  @@index([conversationId])
  @@index([createdAt])
}
